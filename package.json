{
  "name": "chatmcp-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/security/deployment-hold.cjs",
    "dev": "node scripts/security/deployment-hold.cjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "node scripts/security/deployment-hold.cjs",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "start": "node scripts/security/deployment-hold.cjs",
    "deploy": "node scripts/security/deployment-hold.cjs",
    "test:security": "node --test scripts/security/containment.test.mjs"
  },
  "devDependencies": {
    "@turbo/gen": "^1.12.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.6.1",
    "turbo": "^1.12.4"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.2"
  }
}
